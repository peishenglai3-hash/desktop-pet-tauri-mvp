{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Desktop Pet",
  "version": "0.2.0",
  "identifier": "com.codex.ai-desktop-pet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Desktop Pet",
        "label": "main",
        "width": 590,
        "height": 620,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"],
    "targets": ["nsis", "msi"],
    "windows": {
      "nsis": {},
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
